<Project Sdk="Microsoft.NET.Sdk">
    <!-- A Sons of the Forest mod for RedLoader. It builds against the loader and the game code that RedLoader generates
         in the game folder; none of those files are copied into the output or committed to this repository.

         The game folder defaults to Steam's standard location. If yours is elsewhere, pass
         -p:GamePath="<Sons Of The Forest folder>" or create GamePath.user.props next to this file (it is git-ignored):
           <Project><PropertyGroup><GamePath>D:\SteamLibrary\steamapps\common\Sons Of The Forest</GamePath></PropertyGroup></Project>

         Both RedLoader lines are supported and picked automatically from what is installed in the game folder:
           RedLoader 0.9+ (.NET 10, current game version 2.x)  -> _Redloader\net10, builds net10.0
           RedLoader 0.8.x (.NET 6)                            -> _Redloader\net6,  builds net6.0
         Force one with -p:LoaderFlavor=net10 or -p:LoaderFlavor=net6. -->
    <Import Project="GamePath.user.props" Condition="Exists('GamePath.user.props')" />

    <PropertyGroup>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GamePath>
        <LoaderFlavor Condition="'$(LoaderFlavor)' == '' And Exists('$(GamePath)\_Redloader\net10\RedLoader.dll')">net10</LoaderFlavor>
        <LoaderFlavor Condition="'$(LoaderFlavor)' == '' And Exists('$(GamePath)\_Redloader\net6\RedLoader.dll')">net6</LoaderFlavor>
        <LoaderFlavor Condition="'$(LoaderFlavor)' == ''">net10</LoaderFlavor>
        <TargetFramework Condition="'$(LoaderFlavor)' == 'net6'">net6.0</TargetFramework>
        <TargetFramework Condition="'$(LoaderFlavor)' != 'net6'">net10.0</TargetFramework>
        <LoaderDir>$(GamePath)\_Redloader\$(LoaderFlavor)</LoaderDir>
        <GameCodeDir>$(GamePath)\_Redloader\Game</GameCodeDir>

        <AssemblyName>RustHelicopter</AssemblyName>
        <RootNamespace>RustHelicopter</RootNamespace>
        <Version>1.0.0</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <!-- Record source paths as /_/ in the DLL's embedded debug information instead of this PC's folders. -->
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
        <!-- net6.0 is out of support; building it for the older RedLoader is intentional. -->
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- The game's code, as generated by RedLoader (UnityEngine.*, Sons.*, Il2Cppmscorlib, ...). -->
        <Reference Include="$(GameCodeDir)\*.dll" Private="false" />
        <!-- The loader and its SDK. -->
        <Reference Include="$(LoaderDir)\RedLoader.dll" Private="false" />
        <Reference Include="$(LoaderDir)\SonsSdk.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Common.dll" Private="false" />
        <Reference Include="$(LoaderDir)\0Harmony.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- RedLoader reads Mods\<AssemblyName>\manifest.json next to Mods\<AssemblyName>.dll. -->
        <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
        <None Remove="dist\**" />
        <Compile Remove="dist\**" />
    </ItemGroup>

    <!-- dotnet build -t:Deploy : copies the mod into the game's Mods folder. -->
    <Target Name="Deploy" DependsOnTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
        <Copy SourceFiles="manifest.json" DestinationFolder="$(GamePath)\Mods\$(AssemblyName)" />
        <Message Importance="high" Text="Deployed $(AssemblyName) to $(GamePath)\Mods" />
    </Target>

    <!-- dotnet build -c Release -t:Package : a zip laid out like the game folder (Mods\...), in dist\. -->
    <Target Name="Package" DependsOnTargets="Build">
        <PropertyGroup>
            <StageDir>$(MSBuildProjectDirectory)\dist\stage</StageDir>
            <ZipFile>$(MSBuildProjectDirectory)\dist\$(AssemblyName)-$(Version).zip</ZipFile>
        </PropertyGroup>
        <RemoveDir Directories="$(StageDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)\Mods" />
        <Copy SourceFiles="manifest.json" DestinationFolder="$(StageDir)\Mods\$(AssemblyName)" />
        <Delete Files="$(ZipFile)" />
        <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipFile)" />
        <Message Importance="high" Text="Packaged $(ZipFile)" />
    </Target>

    <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SkipGamePathCheck)' != 'true'">
        <Error Condition="!Exists('$(LoaderDir)\RedLoader.dll') Or !Exists('$(GameCodeDir)\Sons.dll')"
               Text="RedLoader or its generated game code was not found under '$(GamePath)'. Install RedLoader, start the game once so it generates _Redloader\Game, or pass -p:GamePath=..." />
    </Target>
</Project>
